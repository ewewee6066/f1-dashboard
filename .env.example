HOST=127.0.0.1
PORT=4321
DATA_DIR=./data
PUBLIC_ORIGIN=
# HTTPS 部署设为 true
COOKIE_SECURE=false
# 留空会自动创建随机密钥，保存在 data/admin-key.txt。勿上传此文件。
ADMIN_KEY=

# 只在 Nginx 等可信反向代理已覆盖 X-Real-IP 时配置其实际来源 IP
TRUST_PROXY_IPS=

# 域名通过 Cloudflare Tunnel 访问时设为 true，读取可信连接器的 CF-Connecting-IP
CLOUDFLARE_TUNNEL=false
# 可选 GitHub 登录：Client ID 与 Secret 同时填写；管理员数字 ID 可留空
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_ID=

# 可选 Google 登录：两项同时配置才显示入口；回调 /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 邮箱验证码：配置前入口隐藏；正式环境强制 TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 可选；留空会生成 DATA_DIR/auth-secret.txt，用于验证码摘要
AUTH_SECRET=
